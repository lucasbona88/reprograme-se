<h1 class="text-center my-3">Cadastro de Estados</h1>
  <form action="/estados/cadastrar" method="post">
 <div class="row w-50 d-block m-auto g-3">
 <div class="col-12">
 <label class="form-label" for="estado">Nome do Estado:</label>
 <input
 class="form-control"
 type="text"
 name="nome"
 id="nome"
 placeholder="Digite o nome da estado"
 />
 </div>

 <div>
 <input class="btn btn-primary my-3" type="submit" value="Cadastrar
estado" />
 </div>
 </div>
</form>